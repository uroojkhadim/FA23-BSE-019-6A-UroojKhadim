<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= restaurant.name %> • Online Food Ordering</title>
<link rel="stylesheet" href="/styles.css">
</head>
<body>
<header>
  <h1><a href="/">Online Food Ordering</a></h1>
</header>
<main>
  <section>
    <h2><%= restaurant.name %></h2>
    <p><%= restaurant.cuisine %></p>
    <form method="post" action="/orders">
      <input type="hidden" name="restaurantId" value="<%= restaurant.id %>">
      <table>
        <thead>
          <tr><th>Item</th><th>Price</th><th>Quantity</th></tr>
        </thead>
        <tbody>
          <% items.forEach(i => { %>
            <tr>
              <td><%= i.name %></td>
              <td>RS <%= i.price.toFixed(2) %></td>
              <td><input type="number" min="0" value="0" name="qty_<%= i.id %>"></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <h3>Customer</h3>
      <div class="form-row">
        <label>Name</label>
        <input type="text" name="customerName" required>
      </div>
      <div class="form-row">
        <label>Address</label>
        <input type="text" name="address" required>
      </div>
      <button type="submit">Place Order</button>
    </form>
  </section>
</main>
<footer>
  <p>© <%= new Date().getFullYear() %> Online Food Ordering</p>
</footer>
</body>
</html>
