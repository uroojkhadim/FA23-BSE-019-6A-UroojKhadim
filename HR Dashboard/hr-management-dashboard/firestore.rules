rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to get current user role
    function getUserRole() {
      return get(/databases/$(database)/documents/hrUsers/$(request.auth.uid)).data.role;
    }

    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/hrUsers/$(request.auth.uid)) &&
        getUserRole() in ['admin'];
    }

    // Helper function to check if user is HR or Admin
    function isHRAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/hrUsers/$(request.auth.uid)) &&
        getUserRole() in ['admin', 'hr-manager', 'recruiter'];
    }

    // Helper function to check if user is employee accessing own data
    function isOwnEmployee(employeeId) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/hrUsers/$(request.auth.uid)) &&
        (getUserRole() in ['admin', 'hr-manager', 'recruiter'] || 
         (getUserRole() == 'employee' && request.auth.uid == employeeId));
    }

    // Jobs collection
    match /jobs/{jobId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isHRAdmin();
    }

    // Candidates collection
    match /candidates/{candidateId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isHRAdmin();
    }

    // HR Users collection
    match /hrUsers/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if isAdmin();
    }

    // Employees collection
    match /employees/{employeeId} {
      allow read: if isOwnEmployee(employeeId);
      allow create, update, delete: if isHRAdmin();
    }

    // Attendance collection
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow create, update: if isHRAdmin() || 
        (isAuthenticated() && 
         exists(/databases/$(database)/documents/employees/$(request.auth.uid)) &&
         request.resource.data.employeeId == request.auth.uid);
    }

    // Leave Requests collection
    match /leaveRequests/{leaveId} {
      allow read: if isOwnEmployee(resource.data.employeeId);
      allow create: if isAuthenticated();
      allow update, delete: if isHRAdmin();
    }

    // Payroll collection
    match /payroll/{payrollId} {
      allow read: if isOwnEmployee(resource.data.employeeId);
      allow create, update, delete: if isHRAdmin();
    }
  }
}
